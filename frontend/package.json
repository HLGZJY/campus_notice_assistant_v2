{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript openapi.json -o src/api/types.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.10",
    "naive-ui": "^2.41.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^5.4.18",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
