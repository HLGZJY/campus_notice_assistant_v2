# opencode-go API 配置（OpenAI 兼容接口）
# 在 config/app.yaml 的 providers.opencode-zen.api_key_env 中引用此变量名
OPENCODE_API_KEY=""

# 如需使用其他供应商，在 config/app.yaml 中添加 provider，并在此处写入对应环境变量：
# OPENAI_API_KEY=""
# DEEPSEEK_API_KEY=""

# 提取批处理参数
EXTRACT_LIMIT=50

# HuggingFace 镜像（避免下载模型时被墙）
HF_ENDPOINT=https://hf-mirror.com

# 以下变量已弃用，现由 config/app.yaml 统一管理：
# OPENCODE_BASE_URL, LLM_MODEL, EMBEDDING_MODEL
